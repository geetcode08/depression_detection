      </nav>

      <div className="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-xs text-amber-800">
        ⚠️ This is not a medical tool. For clinical concerns, consult a licensed professional.
      </div>
    </>
  );
}
