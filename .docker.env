# Docker Compose Environment Variables
# Copy this file to .docker.env for docker-compose

# Backend Configuration
DATABASE_URL=sqlite+aiosqlite:///./depression_ai.db
SECRET_KEY=your-256-bit-secret-use-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Keys (required for functionality)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your-openai-api-key-optional
HF_API_TOKEN=hf_your_huggingface_token_optional

# CORS and Frontend
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://backend:8000/api/v1
NEXTAUTH_SECRET=your-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000
