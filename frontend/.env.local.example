# =============================================================
# Aura Frontend — Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================

# Base URL of the FastAPI backend
# Development: http://localhost:8000/api/v1
# Production: https://your-render-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# NextAuth configuration (required for next-auth integration)
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Set to "false" to use real backend instead of mock data
# NEXT_PUBLIC_USE_MOCK=true
